# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_ANALYSIS_MODEL=deepseek-chat

# jiwen tick 间隔（毫秒），默认 5 分钟
JIWEN_TICK_INTERVAL_MS=300000

# SQLite 路径
SQLITE_PATH=./data/companion.db

# 主动开口配额（24h 内最多 N 条）
OUTREACH_24H_LIMIT=10

# Cron 活跃时段（在此时间段外不主动开口）
JIWEN_CRON_ACTIVE_HOURS_START=8
JIWEN_CRON_ACTIVE_HOURS_END=23

# 角色名字（AI 角色自己的名字，默认"凌"）
CHARACTER_NAME=凌

# 对方昵称（分析 prompt 和状态文案里使用）
SUBJECT_NAME=K

# 记忆系统
MEMORY_SUMMARY_INTERVAL=50   # 每 N 条用户消息生成一次摘要
MEMORY_RETRIEVAL_TOPK=5      # 每次检索返回的记忆数
MEMORY_RERANK_CANDIDATES=20  # FTS5 召回的候选数
